# Copy to .env and fill in. Never commit the real .env.

# ai.google.dev -- create a key in Google AI Studio.
GEMINI_API_KEY=

# Neon Postgres connection string (with pgvector enabled). Get this from
# your Neon project's dashboard -- use the pooled connection string.
DATABASE_URL=

# Optional explicit direct connection for schema migrations. When omitted,
# db/config.py derives it from Neon's pooled hostname by removing "-pooler".
DATABASE_URL_UNPOOLED=

# The Google Drive folder containing the Sampada issue PDFs.
GOOGLE_DRIVE_FOLDER_ID=

# Not in the original env list, but required to actually read Drive (Phase 2):
# create a GCP service account, download its JSON key, share the Drive folder
# above with its client_email as a Viewer, and point this at the key file.
# secrets/ is gitignored -- put it there.
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/drive-service-account.json
