# Copy to .env and fill in. Never commit the real .env or the Drive service
# account JSON key.

AWS_REGION=ap-south-1

# S3 bucket names are globally unique across ALL of AWS -- "sampada-archive"
# from the spec is a placeholder, not a real available name. Pick something
# unique (e.g. mccia-sampada-archive-<random suffix>) and confirm it's free
# with `aws s3api head-bucket --bucket <name>` (should error "Not Found")
# before creating it in Phase 2.
S3_BUCKET=CHANGE-ME
S3_RAW_PREFIX=raw
S3_PROCESSED_PREFIX=processed

# Claude has no native in-region hosting in ap-south-1 -- this MUST be a
# "global." cross-region inference profile ID, not a plain model ID.
# Find valid IDs for your account with:
#   aws bedrock list-inference-profiles --region ap-south-1
# and confirm model access is granted for it in the Bedrock console first.
BEDROCK_ARTICLE_SPLIT_MODEL_ID=CHANGE-ME

# From infra/sampada_stack.py's KnowledgeBaseId / DataSourceId outputs.
# Only needed for `process --upload` -- lets the pipeline trigger
# re-embedding afterwards (uploading to S3 alone does not do this).
BEDROCK_KNOWLEDGE_BASE_ID=CHANGE-ME
BEDROCK_DATA_SOURCE_ID=CHANGE-ME

# Google Drive source (PDFs live here, not yet synced locally).
# 1. Create a GCP service account, download its JSON key to the path below.
# 2. Share the Drive root folder with the service account's client_email
#    (Viewer access is enough -- we only read).
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/drive-service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=CHANGE-ME

LOCAL_STAGING_DIR=./staging/raw
LOCAL_PROCESSED_DIR=./staging/processed
# The archive browse page's data source (Phase 5) -- uploaded to
# s3://<bucket>/index/issues.json, outside processed/ so the knowledge
# base's data source never tries to embed it.
LOCAL_INDEX_PATH=./staging/index/issues.json
MANUAL_REVIEW_LOG=./staging/manual_review.csv
STATE_MANIFEST=./staging/processed_manifest.json
